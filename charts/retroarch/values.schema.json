{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicas": {"type": "integer", "enum": [0, 1]},
    "image": {
      "type": "object",
      "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
      "required": ["digest"]
    },
    "gpu": {
      "type": "object",
      "properties": {
        "resourceName": {"const": "gaming.batchelor.live/amd-gpu"},
        "plugin": {
          "type": "object",
          "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
          "required": ["digest"]
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {"allowedCIDRs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}}
    }
  }
}
